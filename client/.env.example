# Leave empty for local development (Vite's dev proxy forwards /api and
# /socket.io to http://localhost:5000 automatically — see vite.config.ts).
#
# For production builds, set this to your deployed backend's full URL,
# e.g. https://orbitpm-api.onrender.com
VITE_API_URL=

# Optional: shows "Continue with Google". Same value as GOOGLE_CLIENT_ID on the server.
# In Google Cloud Console add http://localhost:5173 (and your deployed URL) under "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
